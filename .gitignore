.claude/

# --- Training outputs -------------------------------------------------------
# logs/ is large & reproducible: keep it out of git EXCEPT the committed result
# files (per-algo sweep summaries, finals DONE.json, generalization results).
# NB: parent dirs must be re-included step-by-step to reach the files.
logs/*
!logs/sweeps/
logs/sweeps/*
!logs/sweeps/*/
logs/sweeps/*/*
!logs/sweeps/*/summary.csv
!logs/finals/
logs/finals/*
!logs/finals/*/
logs/finals/*/*
!logs/finals/*/DONE.json
!logs/generalization/
logs/generalization/*
!logs/generalization/results.csv

# --- Model binaries ---------------------------------------------------------
# Not committed by default, EXCEPT the four final agents the marker loads.
*.zip
*.pt
*.pth
!models/dqn/dqn.zip
!models/pg/ppo.zip
!models/pg/a2c.zip
!models/pg/reinforce.pt
