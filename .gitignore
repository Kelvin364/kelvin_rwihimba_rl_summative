# ---- Python / tooling ------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store

# ---- Training outputs ------------------------------------------------------
# I version everything needed to verify and redraw my results — the per-run
# metrics (summary.csv, DONE.json), the generalization table, and the raw
# learning curves (progress.csv, episode_rewards.csv) that every figure in the
# report is drawn from. What I leave out is the bulk: intermediate checkpoints
# and per-run model binaries, which come to ~144 MB and are fully regenerated by
# `uv run python -m training.run_all --phase all`.
logs/**/checkpoints/
logs/gate/
logs/smoke/
logs/validation/

# ---- Trained agents --------------------------------------------------------
# Only the four final agents that main.py loads are committed; every other
# binary is an intermediate.
*.zip
*.pt
*.pth
!models/dqn/dqn.zip
!models/pg/ppo.zip
!models/pg/a2c.zip
!models/pg/reinforce.pt



# Single-run viewer produced by `main.py --view web` (index.html is the curated one)
assets/demo/last_run.html
